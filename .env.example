# Copiar a .env y llenar. NUNCA subir .env al repositorio.

# Dominio público (Caddy saca el certificado HTTPS solo)
DOMINIO=erp.tuempresa.mx

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=erp.tuempresa.mx
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.tuempresa.mx

# PostgreSQL
POSTGRES_DB=avocontrol
POSTGRES_USER=avocontrol
POSTGRES_PASSWORD=cambia-esta-contraseña

# Seguridad de login
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
